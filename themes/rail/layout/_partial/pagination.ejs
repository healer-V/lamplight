<% if (page.total > 1) { %>
<nav class="pagination" aria-label="分页">
  <% if (page.prev) { %><a href="<%- url_for(page.prev_link) %>"><%- icon('arrowLeft') %>较新</a><% } else { %><span></span><% } %>
  <span class="count">第 <%= page.current %> / <%= page.total %> 页</span>
  <% if (page.next) { %><a href="<%- url_for(page.next_link) %>">较早<%- icon('arrowRight') %></a><% } else { %><span></span><% } %>
</nav>
<% } %>
